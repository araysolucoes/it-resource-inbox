<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_email_user" model="res.groups">
        <field name="name">Email Inbox / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_email_manager" model="res.groups">
        <field name="name">Email Inbox / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_email_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
