<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_email_compose_form" model="ir.ui.view">
        <field name="name">email.compose.form</field>
        <field name="model">email.compose</field>
        <field name="arch" type="xml">
            <form class="o_email_compose">
                <div class="o_email_compose_banner o_email_compose_new" attrs="{'invisible': [('mode', '!=', 'new')]}">
                    <strong>New message</strong>
                    <span>It goes out through the SMTP-enabled account chosen below.</span>
                </div>
                <div class="o_email_compose_banner o_email_compose_reply" attrs="{'invisible': [('mode', '!=', 'reply')]}">
                    <strong>Reply</strong>
                    <span>The recipient sees this message as a continuation of the previous one.</span>
                </div>
                <group>
                    <group string="Sent Through">
                        <field name="template_id" attrs="{'invisible': [('mode', '!=', 'new')]}" options="{'no_create': True}"/>
                        <field name="account_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="body_format"/>
                    </group>
                    <group string="Recipients">
                        <field name="email_to" string="Recipient" placeholder="name@company.com"/>
                        <field name="email_cc" string="Cc" placeholder="copy@company.com"/>
                        <field name="parent_id" string="In Reply To" attrs="{'invisible': [('mode', '=', 'new')]}" readonly="1"/>
                    </group>
                </group>
                <separator string="Content"/>
                <group>
                    <field name="subject" placeholder="Subject the recipient will read"/>
                </group>
                <field name="body" nolabel="1" placeholder="Write your message here."
                       attrs="{'invisible': [('body_format', '=', 'html')]}"/>
                <group attrs="{'invisible': [('body_format', '!=', 'html')]}">
                    <field name="layout_file" filename="layout_filename"/>
                    <field name="layout_filename" invisible="1"/>
                </group>
                <p class="text-muted" attrs="{'invisible': [('body_format', '!=', 'html')]}">
                    .html, .htm, .xml or .hml file. Its content replaces the text and appears in the preview.
                </p>
                <separator string="Preview"/>
                <div class="o_email_preview">
                    <field name="preview_html" nolabel="1" readonly="1"/>
                </div>
                <separator string="Attachments"/>
                <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                <field name="mode" invisible="1"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <footer>
                    <button name="action_send" type="object" string="Send Message" class="oe_highlight" icon="fa-paper-plane"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_email_compose" model="ir.actions.act_window">
        <field name="name">Send Message</field>
        <field name="res_model">email.compose</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_mode': 'new'}</field>
    </record>
</odoo>
