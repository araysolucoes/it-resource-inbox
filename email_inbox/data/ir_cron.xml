<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_email_fetch" model="ir.cron">
        <field name="name">Email: fetch POP3</field>
        <field name="model_id" ref="model_email_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_fetch_all()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
    <function model="email.account" name="_sync_existing_accounts"/>
</odoo>
