<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_resource_unit_tree" model="ir.ui.view">
        <field name="name">it.resource.unit.tree</field>
        <field name="model">it.resource.unit</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'assigned'" decoration-success="state == 'available'">
                <field name="name"/>
                <field name="item_id"/>
                <field name="state"/>
                <field name="assigned_user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_it_resource_unit_form" model="ir.ui.view">
        <field name="name">it.resource.unit.form</field>
        <field name="model">it.resource.unit</field>
        <field name="arch" type="xml">
            <form class="o_it_unit_form">
                <sheet>
                    <div class="o_it_callout">
                        <h3>A unit is a single piece</h3>
                        <p>Use the equipment serial number, the license key or the VPN login. Available units can go into a request. Assigned units are already with someone.</p>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="E.g.: SN-1044, AAAA-BBBB or maria.vpn"/></h1>
                    </div>
                    <group>
                        <group string="Item it belongs to">
                            <field name="item_id"/>
                            <field name="state"/>
                        </group>
                        <group string="Who has it">
                            <field name="assigned_user_id"/>
                            <field name="assigned_line_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_resource_unit_search" model="ir.ui.view">
        <field name="name">it.resource.unit.search</field>
        <field name="model">it.resource.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="item_id"/>
                <field name="assigned_user_id"/>
                <filter name="filter_free" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="filter_busy" string="In use" domain="[('state', '=', 'assigned')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_item" string="Item" context="{'group_by': 'item_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_it_resource_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">it.resource.unit</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No unit registered</p>
            <p>Serial, key or VPN user. Only items tracked by unit use this list.</p>
        </field>
    </record>
</odoo>
