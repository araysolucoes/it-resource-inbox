<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_resource_item_kanban" model="ir.ui.view">
        <field name="name">it.resource.item.kanban</field>
        <field name="model">it.resource.item</field>
        <field name="arch" type="xml">
            <kanban class="o_it_item_kanban">
                <field name="name"/>
                <field name="code"/>
                <field name="item_type"/>
                <field name="category"/>
                <field name="tracking"/>
                <field name="qty_available"/>
                <field name="is_short"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_it_item_card #{record.is_short.raw_value and 'o_it_item_short' or ''}">
                            <div class="o_it_request_top">
                                <strong><field name="name"/></strong>
                                <span class="o_it_item_qty"><field name="qty_available"/></span>
                            </div>
                            <div class="o_it_item_code" t-if="record.code.raw_value">
                                <field name="code"/>
                            </div>
                            <div class="o_it_item_pills">
                                <span class="badge badge-pill o_it_pill"><field name="item_type"/></span>
                                <span class="badge badge-pill o_it_pill"><field name="category"/></span>
                                <span class="badge badge-pill o_it_pill_track"><field name="tracking"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_it_resource_item_tree" model="ir.ui.view">
        <field name="name">it.resource.item.tree</field>
        <field name="model">it.resource.item</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_short == True" decoration-muted="active == False">
                <field name="name"/>
                <field name="code"/>
                <field name="item_type"/>
                <field name="category"/>
                <field name="tracking"/>
                <field name="qty_available"/>
                <field name="is_short" invisible="1"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_it_resource_item_form" model="ir.ui.view">
        <field name="name">it.resource.item.form</field>
        <field name="model">it.resource.item</field>
        <field name="arch" type="xml">
            <form class="o_it_item_form">
                <sheet>
                    <widget name="web_ribbon" title="Inactive" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="E.g.: Notebook 14, Office VPN, Office 365"/></h1>
                        <label for="code" string="Code used by other modules"/>
                        <h2><field name="code" placeholder="notebook_14"/></h2>
                    </div>
                    <div class="o_it_callout">
                        <h3>How this item is counted</h3>
                        <p>By quantity: fill in the number on hand. Fulfilling decreases it. Returning increases it.</p>
                        <p>By unit: each serial, license key or VPN user is a line in the Units tab. Fulfilling marks a free one as in use.</p>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="item_type"/>
                            <field name="category"/>
                            <field name="tracking"/>
                            <field name="active"/>
                        </group>
                        <group string="Availability">
                            <field name="qty_on_hand" attrs="{'invisible': [('tracking', '!=', 'quantity')]}"/>
                            <field name="qty_available"/>
                            <field name="is_short" invisible="1"/>
                        </group>
                    </group>
                    <separator string="What it is for"/>
                    <field name="description" nolabel="1" placeholder="Who can request it and what the person receives."/>
                    <notebook>
                        <page string="Units" attrs="{'invisible': [('tracking', '!=', 'unit')]}">
                            <p class="text-muted">One line per serial, key or login. The Available status is what a request can use.</p>
                            <field name="unit_ids">
                                <tree editable="bottom" decoration-muted="state == 'assigned'">
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="assigned_user_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Deliveries">
                            <field name="assignment_ids" readonly="1">
                                <tree decoration-muted="returned == True">
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_id"/>
                                    <field name="returned"/>
                                    <field name="return_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_it_resource_item_search" model="ir.ui.view">
        <field name="name">it.resource.item.search</field>
        <field name="model">it.resource.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_physical" string="Physical" domain="[('item_type', '=', 'physical')]"/>
                <filter name="filter_virtual" string="Virtual" domain="[('item_type', '=', 'virtual')]"/>
                <filter name="filter_short" string="Out of stock" domain="[('qty_available', '&lt;=', 0)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'item_type'}"/>
                    <filter name="group_tracking" string="Tracking" context="{'group_by': 'tracking'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_it_resource_item" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">it.resource.item</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first item</p>
            <p>Equipment, VPN or license. The code is the name other modules use to request this item.</p>
        </field>
    </record>
</odoo>
