<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_it_resource_user" model="res.groups">
        <field name="name">Requester</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees and follows only the requests they opened themselves.</field>
    </record>

    <record id="group_it_approval_ti" model="res.groups">
        <field name="name">Approval 1</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Sees only the requests still waiting for their approval.</field>
    </record>

    <record id="group_it_approval_board" model="res.groups">
        <field name="name">Approval 2</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Sees only the requests still waiting for their approval.</field>
    </record>

    <record id="group_it_resource_manager" model="res.groups">
        <field name="name">all_perms</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_it_resource_user')), (4, ref('group_it_approval_ti')), (4, ref('group_it_approval_board'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Sees all requests and handles catalog, allocation, settings and both approvals.</field>
    </record>

    <record id="group_it_level_directed" model="res.groups">
        <field name="name">Directed to the user</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Sees requests where they are the collaborator or an approver who still has to decide.</field>
    </record>

    <record id="group_it_tab_request" model="res.groups">
        <field name="name">Tab Requests</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Opens the requests menu.</field>
    </record>

    <record id="group_it_tab_catalog" model="res.groups">
        <field name="name">Tab Catalog</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Opens the catalog menu.</field>
    </record>

    <record id="group_it_tab_use" model="res.groups">
        <field name="name">Tab In use</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Opens the menu showing who holds each item.</field>
    </record>

    <record id="group_it_tab_config" model="res.groups">
        <field name="name">Tab Settings</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Opens the settings menu of the module.</field>
    </record>

    <record id="it_resource_request_user_rule" model="ir.rule">
        <field name="name">IT request: requester sees only their own</field>
        <field name="model_id" ref="model_it_resource_request"/>
        <field name="groups" eval="[(4, ref('group_it_resource_user'))]"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
    </record>

    <record id="it_resource_request_manager_rule" model="ir.rule">
        <field name="name">IT request: manager sees all</field>
        <field name="model_id" ref="model_it_resource_request"/>
        <field name="groups" eval="[(4, ref('group_it_resource_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="it_resource_request_line_user_rule" model="ir.rule">
        <field name="name">IT line: requester sees their own</field>
        <field name="model_id" ref="model_it_resource_request_line"/>
        <field name="groups" eval="[(4, ref('group_it_resource_user'))]"/>
        <field name="domain_force">[('request_id.requested_by', '=', user.id)]</field>
    </record>

    <record id="it_resource_request_line_manager_rule" model="ir.rule">
        <field name="name">IT line: manager sees all</field>
        <field name="model_id" ref="model_it_resource_request_line"/>
        <field name="groups" eval="[(4, ref('group_it_resource_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="it_resource_request_ti_rule" model="ir.rule">
        <field name="name">IT request: Approval 1 sees only what waits for their decision</field>
        <field name="model_id" ref="model_it_resource_request"/>
        <field name="groups" eval="[(4, ref('group_it_approval_ti'))]"/>
        <field name="domain_force">[('pending_ti_user_ids', 'in', user.id)]</field>
    </record>

    <record id="it_resource_request_board_rule" model="ir.rule">
        <field name="name">IT request: Approval 2 sees only what waits for their decision</field>
        <field name="model_id" ref="model_it_resource_request"/>
        <field name="groups" eval="[(4, ref('group_it_approval_board'))]"/>
        <field name="domain_force">[('pending_board_user_ids', 'in', user.id)]</field>
    </record>

    <record id="it_resource_request_line_ti_rule" model="ir.rule">
        <field name="name">IT line: Approval 1 sees only lines of a pending decision</field>
        <field name="model_id" ref="model_it_resource_request_line"/>
        <field name="groups" eval="[(4, ref('group_it_approval_ti'))]"/>
        <field name="domain_force">[('request_id.pending_ti_user_ids', 'in', user.id)]</field>
    </record>

    <record id="it_resource_request_line_board_rule" model="ir.rule">
        <field name="name">IT line: Approval 2 sees only lines of a pending decision</field>
        <field name="model_id" ref="model_it_resource_request_line"/>
        <field name="groups" eval="[(4, ref('group_it_approval_board'))]"/>
        <field name="domain_force">[('request_id.pending_board_user_ids', 'in', user.id)]</field>
    </record>

    <record id="it_resource_request_directed_rule" model="ir.rule">
        <field name="name">IT request: sees what was directed to the user</field>
        <field name="model_id" ref="model_it_resource_request"/>
        <field name="groups" eval="[(4, ref('group_it_level_directed'))]"/>
        <field name="domain_force">['|', '|', '|', ('collaborator_id', '=', user.id), ('line_ids.collaborator_id', '=', user.id), ('pending_ti_user_ids', 'in', user.id), ('pending_board_user_ids', 'in', user.id)]</field>
    </record>

    <record id="it_resource_request_line_directed_rule" model="ir.rule">
        <field name="name">IT line: sees what was directed to the user</field>
        <field name="model_id" ref="model_it_resource_request_line"/>
        <field name="groups" eval="[(4, ref('group_it_level_directed'))]"/>
        <field name="domain_force">['|', '|', '|', '|', ('collaborator_id', '=', user.id), ('request_id.collaborator_id', '=', user.id), ('request_id.pending_ti_user_ids', 'in', user.id), ('request_id.pending_board_user_ids', 'in', user.id), ('request_id.line_ids.collaborator_id', '=', user.id)]</field>
    </record>

    <record id="it_resource_assignment_user_rule" model="ir.rule">
        <field name="name">IT assignment: requester sees who holds the item</field>
        <field name="model_id" ref="model_it_resource_assignment"/>
        <field name="groups" eval="[(4, ref('group_it_resource_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <delete model="ir.rule" id="it_resource_request_collaborator_rule"/>
    <delete model="ir.rule" id="it_resource_request_approver_rule"/>
    <delete model="ir.rule" id="it_resource_request_line_collaborator_rule"/>

    <record id="it_resource_signature_user_rule" model="ir.rule">
        <field name="name">IT signature: signer or requester</field>
        <field name="model_id" ref="model_it_resource_signature"/>
        <field name="groups" eval="[(4, ref('group_it_resource_user'))]"/>
        <field name="domain_force">['|', ('signer_id', '=', user.id), ('request_id.requested_by', '=', user.id)]</field>
    </record>

    <record id="it_resource_signature_manager_rule" model="ir.rule">
        <field name="name">IT signature: manager sees all</field>
        <field name="model_id" ref="model_it_resource_signature"/>
        <field name="groups" eval="[(4, ref('group_it_resource_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="it_resource_assignment_manager_rule" model="ir.rule">
        <field name="name">IT assignment: manager sees all</field>
        <field name="model_id" ref="model_it_resource_assignment"/>
        <field name="groups" eval="[(4, ref('group_it_resource_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
