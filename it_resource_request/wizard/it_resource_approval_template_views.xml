<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_resource_approval_template_wizard" model="ir.ui.view">
        <field name="name">it.resource.approval.template.wizard.form</field>
        <field name="model">it.resource.approval.template.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="setting_id" invisible="1"/>
                    <field name="name"/>
                    <field name="kind"/>
                    <field name="body_format"/>
                    <field name="in_use"/>
                    <field name="email_to" attrs="{'invisible': [('kind', '!=', 'third')], 'required': [('kind', '=', 'third')]}"/>
                    <field name="approve_token" attrs="{'invisible': [('kind', '!=', 'third')], 'required': [('kind', '=', 'third')]}"/>
                    <field name="refuse_token" attrs="{'invisible': [('kind', '!=', 'third')], 'required': [('kind', '=', 'third')]}"/>
                </group>
                <separator string="Message"/>
                <field name="body" nolabel="1" placeholder="Request {{{pedido}}}. Reply {{{aprovar}}} or {{{recusar}}}."/>
                <footer>
                    <button name="action_create" type="object" string="Create template" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
